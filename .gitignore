# ─── Python ────────────────────────────────────────────────────────────────
# Bytecode / optimized files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
*.egg-info/
*.egg
build/
dist/
wheels/
pip-wheel-metadata/

# Virtual environments
.venv/
venv/
env/
ENV/

# uv (uncomment if you don't want the lock file tracked)
# uv.lock

# Test / coverage
.pytest_cache/
.coverage
.coverage.*
htmlcov/
.cache/
.tox/
.nox/
coverage.xml
*.cover

# Type checkers / linters
.mypy_cache/
.ruff_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints/
profile_default/

# ─── Secrets / local config ────────────────────────────────────────────────
# Environment files — keep .env.example tracked
.env
.env.*
!.env.example

# Docker secrets
secrets/
*.pem
*.key

# ─── Docker ────────────────────────────────────────────────────────────────
# Dockerfile and compose.yaml are intentionally tracked

