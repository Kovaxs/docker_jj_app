# !.vscode/extensions.json

# JetBrains / IntelliJ
.idea/
*.iml
*.iws
*.ipr

# Sublime / Vim / Emacs
*.sublime-project
*.sublime-workspace
*.swp
*.swo
*~
.vscode-test/
.history/

# ─── OS ────────────────────────────────────────────────────────────────────
